@{
    ViewData["Title"] = "Información KRÒ Training";
}

<div class="kro-page-title">
    Conoce KRÒ Training
</div>

<p class="kro-page-subtitle">
    Servicios disponibles para nuestros clientes.
</p>

<div class="kro-actions" style="margin-bottom:20px; flex-wrap:wrap;">
    @if (User.Identity!.IsAuthenticated)
    {
        @if (User.IsInRole("CLIENTE"))
        {
            <a href="/ControlAsistencia/RegistrarIngreso" class="kro-btn kro-btn-outline">Registrar mi ingreso</a>
        }
        @if (User.IsInRole("ADMINISTRADOR"))
        {
            <a href="/ControlAsistencia/HistorialAsistencia" class="kro-btn kro-btn-outline">Historial de asistencia</a>
        }
        @if (User.IsInRole("ENTRENADOR"))
        {
            <a href="/ControlAsistencia/VisualizarAsistencia" class="kro-btn kro-btn-outline">Mis clientes</a>
        }
        <a href="/Cuenta/Perfil" class="kro-btn kro-btn-outline">Mi perfil</a>
        <form asp-controller="Cuenta" asp-action="Logout" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit" class="kro-btn kro-btn-secondary">Cerrar sesión</button>
        </form>
    }
    else
    {
        <a href="/Cuenta/Login" class="kro-btn kro-btn-outline">Iniciar sesión</a>
        <a href="/Cuenta/Registro" class="kro-btn kro-btn-primary">Crear cuenta</a>
    }
</div>

<div class="kro-card">

    <div class="kro-card-title">
        Nuestros servicios
    </div>

    <div class="kro-stat-grid">

        <div class="kro-stat-card">
            <h3>ENTRENAMIENTO PERSONALIZADO</h3>
            <strong style="font-size:16px;">Rutinas según tu nivel y objetivo</strong>
        </div>

        <div class="kro-stat-card">
            <h3>SEGUIMIENTO FÍSICO</h3>
            <strong style="font-size:16px;">Evaluaciones y metas medibles</strong>
        </div>

        <div class="kro-stat-card">
            <h3>EVENTOS Y CLASES</h3>
            <strong style="font-size:16px;">Actividades grupales todo el año</strong>
        </div>

    </div>

</div>