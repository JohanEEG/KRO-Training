        </table>

    </div>

</div>


<div class="kro-card">

    <div class="kro-card-title">
        Indicadores de rendimiento
    </div>


    <div class="kro-form-grid">

        <div class="kro-form-group">

            <label class="kro-form-label">
                Retención de clientes
            </label>

            <div style="font-size:28px; font-weight:700;">
                91%
