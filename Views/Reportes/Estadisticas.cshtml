@{
    ViewData["Title"] = "Reportes Estadísticos";
}

<div class="kro-page-title">
    Reportes estadísticos
</div>

<p class="kro-page-subtitle">
    Consulte estadísticas de asistencia, membresías y rendimiento del gimnasio.
</p>


<div class="kro-card">

    <div class="kro-card-title">
        Parámetros del reporte
    </div>


    <div class="kro-form-grid">

        <div class="kro-form-group">

            <label class="kro-form-label">
                Fecha inicial
            </label>

            <input type="date"
                   class="kro-form-control" />

        </div>


        <div class="kro-form-group">

            <label class="kro-form-label">
                Fecha final
            </label>

            <input type="date"
                   class="kro-form-control" />

        </div>


        <div class="kro-form-group">

            <label class="kro-form-label">
                Tipo de estadística
            </label>

            <select class="kro-form-control">

                <option>Resumen general</option>
                <option>Asistencia</option>
                <option>Membresías</option>
                <option>Rendimiento</option>

            </select>

        </div>

    </div>


    <div class="kro-actions">

        <button type="button"
                class="kro-btn kro-btn-primary"
                onclick="alert('Reporte estadístico generado correctamente.');">
            Generar reporte
        </button>

    </div>

</div>


<div class="kro-stat-grid">

    <div class="kro-stat-card">

        <h3>
            ASISTENCIAS
        </h3>

        <strong>
            486
        </strong>

    </div>


    <div class="kro-stat-card">

        <h3>
            MEMBRESÍAS ACTIVAS
        </h3>

        <strong>
            186
        </strong>

    </div>


    <div class="kro-stat-card">

        <h3>
            NUEVAS MEMBRESÍAS
        </h3>

        <strong>
            32
        </strong>

    </div>


    <div class="kro-stat-card">

        <h3>
            CLIENTES ACTIVOS
        </h3>

        <strong>
            248
        </strong>

    </div>

</div>


<div class="kro-card">

    <div class="kro-card-title">
        Resumen de asistencia
    </div>


    <div class="kro-table-container">

        <table class="kro-table">

            <thead>

                <tr>
                    <th>Periodo</th>
                    <th>Asistencias</th>
                    <th>Clientes activos</th>
                    <th>Promedio diario</th>
                    <th>Variación</th>
                </tr>

            </thead>


            <tbody>

