@{
    ViewData["Title"] = "Clientes en Riesgo de Deserción";
}

<div class="kro-page-title">
    Clientes en riesgo de deserción
</div>

<p class="kro-page-subtitle">
    Consulte los clientes identificados con riesgo de abandonar el gimnasio para tomar acciones preventivas.
</p>


<div class="kro-card">

    <div class="kro-card-title">
        Parámetros de consulta
    </div>


    <div class="kro-form-grid">

        <div class="kro-form-group">

            <label class="kro-form-label">
                Fecha inicial
            </label>

            <input type="date"
                   class="kro-form-control" />

        </div>


        <div class="kro-form-group">

            <label class="kro-form-label">
                Fecha final
            </label>

            <input type="date"
                   class="kro-form-control" />

        </div>


        <div class="kro-form-group">

            <label class="kro-form-label">
                Nivel de riesgo
            </label>

            <select class="kro-form-control">

                <option>Todos los niveles</option>
                <option>Alto</option>
                <option>Medio</option>
                <option>Bajo</option>

            </select>

        </div>

    </div>


    <div class="kro-actions">

        <button type="button"
                class="kro-btn kro-btn-primary"
                onclick="alert('Reporte generado correctamente.');">
            Generar reporte
        </button>

    </div>

</div>


<div class="kro-stat-grid">

    <div class="kro-stat-card">

        <h3>
            CLIENTES EN RIESGO
