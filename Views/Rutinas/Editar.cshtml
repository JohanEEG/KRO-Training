@model KROTraining.Models.EditarRutinaViewModel

@{
    ViewData["Title"] = "Editar rutina";
}

<h1 class="kro-page-title">Editar rutina</h1>

<p class="kro-page-subtitle">
    Actualice la información y los ejercicios de la rutina.
</p>

@if (ViewData["MensajeInformativo"] is string mensaje)
{
    <div role="status"
         style="background:#E3F2FD; color:#0D47A1;
        border-left:4px solid #1976D2;
        padding:16px; border-radius:8px; margin-bottom:20px;">
        @mensaje
    </div>
}

<form asp-controller="Rutinas"
      asp-action="Editar"
      asp-route-id="@Model.RutinaId"
      method="post">

    <input type="hidden" asp-for="RutinaId" />

    <div asp-validation-summary="All"
         role="alert"
         style="color:#B71C1C; margin-bottom:16px;">
    </div>

    <div class="kro-card">

        <h2 class="kro-card-title">Información de la rutina</h2>

        <div style="margin-bottom:20px;">
            <label asp-for="Nombre" class="kro-form-label">
                Nombre de la rutina *
            </label>

            <input asp-for="Nombre"
                   class="kro-form-control"
                   maxlength="150"
                   required />
        </div>

        <div style="margin-bottom:20px;">
            <label asp-for="Descripcion"
                   class="kro-form-label"></label>

            <textarea asp-for="Descripcion"
                      class="kro-form-control"
                      rows="4"></textarea>
        </div>

        <div style="display:grid;
            grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
            gap:20px;">

            <div>
                <label asp-for="Objetivo"
                       class="kro-form-label"></label>

                <input asp-for="Objetivo"
                       class="kro-form-control"
                       maxlength="100" />
            </div>

            <div>
                <label asp-for="Nivel"
                       class="kro-form-label"></label>

                <select asp-for="Nivel"
                        class="kro-form-control">
                    <option value="">Sin especificar</option>
                    <option value="PRINCIPIANTE">Principiante</option>
                    <option value="INTERMEDIO">Intermedio</option>
                    <option value="AVANZADO">Avanzado</option>
                </select>
            </div>
        </div>
    </div>

    <div class="kro-card" style="margin-top:24px;">

        <h2 class="kro-card-title">Ejercicios de la rutina</h2>

        @if (Model.Ejercicios.Count == 0)
        {
            <p style="color:#666;">
                Esta rutina todavía no tiene ejercicios.
                Puede agregarlos desde el listado de rutinas.
            </p>
        }
        else
        {
            <p style="color:#666;">
                Las series y repeticiones deben ser mayores que cero.
                El descanso se expresa en segundos y puede ser cero.
            </p>

            @for (var i = 0; i < Model.Ejercicios.Count; i++)
            {
                <fieldset style="border:1px solid #DDD;
                    border-radius:8px; padding:20px;
                    margin:0 0 20px; min-width:0;">

                    <legend style="font-weight:600; padding:0 8px;">
                        @Model.Ejercicios[i].Orden.
                        @Model.Ejercicios[i].NombreEjercicio
                    </legend>

                    <input type="hidden"
                           asp-for="Ejercicios[i].EjercicioId" />

                    <div style="display:grid;
                        grid-template-columns:repeat(auto-fit, minmax(160px, 1fr));
                        gap:20px;">

                        <div>
                            <label asp-for="Ejercicios[i].Series"
                                   class="kro-form-label"></label>

                            <input asp-for="Ejercicios[i].Series"
                                   class="kro-form-control"
                                   type="number"
                                   min="1"
                                   max="2147483647"
                                   step="1"
                                   required />
                        </div>

                        <div>
                            <label asp-for="Ejercicios[i].Repeticiones"
                                   class="kro-form-label"></label>

                            <input asp-for="Ejercicios[i].Repeticiones"
                                   class="kro-form-control"
                                   type="number"
                                   min="1"
                                   max="2147483647"
                                   step="1"
                                   required />
                        </div>

                        <div>
                            <label asp-for="Ejercicios[i].DescansoSegundos"
                                   class="kro-form-label"></label>

                            <input asp-for="Ejercicios[i].DescansoSegundos"
                                   class="kro-form-control"
                                   type="number"
                                   min="0"
                                   max="2147483647"
                                   step="1"
                                   required />
                        </div>
                    </div>
                </fieldset>
            }
        }
    </div>

    <div style="display:flex; justify-content:flex-end;
        gap:12px; flex-wrap:wrap; margin-top:24px;">

        <a asp-controller="Rutinas"
           asp-action="Index"
           class="kro-btn kro-btn-outline">
            Cancelar
        </a>

        <button type="submit"
                class="kro-btn kro-btn-primary">
            Guardar cambios
        </button>
    </div>
</form>
