@model System.Collections.Generic.List<KROTraining.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de usuarios";
}

<h1 class="kro-page-title">
    Gestión de usuarios
</h1>

<p class="kro-page-subtitle">
    Consulte las cuentas registradas y asigne sus roles.
</p>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div role="status"
         style="padding:16px 20px;
        margin-bottom:20px;
        border:1px solid #B8DCC4;
        border-radius:10px;
        background:#EAF5EE;
        color:#24643D;">
        @mensaje
    </div>
}

<div class="kro-card">

    <div style="display:flex;
        justify-content:space-between;
        align-items:center;
        gap:16px;
        flex-wrap:wrap;
        margin-bottom:24px;">

        <h2 class="kro-card-title" style="margin:0;">
            Usuarios registrados
        </h2>

        <span style="color:#656565; font-size:14px;">
            Total: @Model.Count
        </span>
    </div>

    @if (Model.Count == 0)
    {
        <p role="status">
            No hay usuarios registrados.
        </p>
    }
    else
    {
        <div class="kro-form-group" style="margin-bottom:24px;">
            <label for="buscarUsuario" class="kro-form-label">
                Buscar usuario
            </label>

            <input type="search"
                   id="buscarUsuario"
                   class="kro-form-control"
                   placeholder="Nombre, correo, rol o estado..." />
        </div>

        <div class="kro-table-container" style="overflow-x:auto;">
            <table class="kro-table" id="tablaUsuarios">
                <thead>
                    <tr>
                        <th scope="col">Nombre</th>
                        <th scope="col">Correo</th>
                        <th scope="col">Rol</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>@usuario.Nombre</td>
                            <td>@usuario.Correo</td>
                            <td>
                                <span class="kro-badge kro-badge-gray">
                                    @usuario.Rol.Nombre
                                </span>
                            </td>
                            <td>
                                <span class="kro-badge @(usuario.Estado == "ACTIVO" ? "kro-badge-green" : "kro-badge-gray")">
                                    @usuario.Estado
                                </span>
                            </td>
                            <td>
                                <a asp-controller="Usuarios"
                                   asp-action="AsignarRol"
                                   asp-route-id="@usuario.UsuarioId"
                                   class="kro-btn kro-btn-small kro-btn-outline"
                                   aria-label="@($"Asignar rol a {usuario.Nombre}")">
                                    Asignar rol
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p id="sinResultados" role="status" hidden>
            No hay usuarios que coincidan con la búsqueda.
        </p>
    }
</div>

<script>
    (() => {
        const buscador = document.getElementById("buscarUsuario");
        const tabla = document.getElementById("tablaUsuarios");
        const aviso = document.getElementById("sinResultados");

        if (!buscador || !tabla || !aviso) {
            return;
        }

        buscador.addEventListener("input", () => {
            const busqueda = buscador.value.trim().toLocaleLowerCase();
            let visibles = 0;

            for (const fila of tabla.tBodies[0].rows) {
                const texto = Array.from(fila.cells)
                    .slice(0, 4)
                    .map(celda => celda.textContent)
                    .join(" ")
                    .toLocaleLowerCase();

                const coincide = texto.includes(busqueda);

                fila.hidden = !coincide;

                if (coincide) {
                    visibles++;
                }
            }

            aviso.hidden = visibles > 0;
        });
    })();
</script>