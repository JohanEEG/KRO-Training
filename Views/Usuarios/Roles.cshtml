@model System.Collections.Generic.List<KROTraining.Models.Rol>
@{
    ViewData["Title"] = "Roles y Permisos";
}

@if (TempData["MensajeExito"] is string mensaje)
{
    <div role="status"
         style="padding:16px;
        margin-bottom:20px;
        border:1px solid #A5D6A7;
        border-radius:8px;
        background:#E8F5E9;
        color:#1B5E20;">
        @mensaje
    </div>
}

<div class="kro-page-title">
    Roles y permisos
</div>

<p class="kro-page-subtitle">
    Administre los niveles de acceso y las acciones disponibles para cada rol.
</p>


<div class="kro-card">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">

        <div class="kro-card-title" style="margin:0;">
            Roles registrados
        </div>

        <a href="/Usuarios/NuevoRol"
           class="kro-btn kro-btn-primary">

            + Nuevo rol

        </a>

    </div>


    <div class="kro-table-container">
        <table class="kro-table">
            <thead>
                <tr>
                    <th scope="col">Rol</th>
                    <th scope="col">Permisos configurados</th>
                    <th scope="col">Cantidad</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4">
                            No hay roles registrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var rol in Model)
                    {
                        var claseRol = rol.Nombre == "ADMINISTRADOR"
                            ? "kro-badge-red"
                            : "kro-badge-gray";

                        <tr>
                            <td>
                                <span class="kro-badge @claseRol">
                                    @rol.Nombre
                                </span>
                            </td>

                            <td>
                                @if (rol.Permisos.Count == 0)
                                {
                                    <span style="color:#666;">
                                        Sin permisos configurados.
                                    </span>
                                }
                                else
                                {
                                    <ul style="margin:0; padding-left:20px;">
                                        @foreach (var permiso in rol.Permisos.OrderBy(p => p.Nombre))
                                        {
                                            <li>@permiso.Nombre</li>
                                        }
                                    </ul>
                                }
                            </td>

                            <td>
                                @rol.Permisos.Count
                            </td>

                            <td>
                                <a asp-controller="Usuarios"
                                   asp-action="EditarRol"
                                   asp-route-id="@rol.RolId"
                                   class="kro-btn kro-btn-small kro-btn-outline"
                                   aria-label="@($"Configurar permisos de {rol.Nombre}")">
                                    Configurar permisos
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="kro-card">

    <div class="kro-card-title">
        Descripción de roles
    </div>


    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px;">

        <div>

            <h3 style="font-family:Montserrat;">
                Administrador
            </h3>

            <p style="color:#666; font-size:14px;">
                Tiene acceso completo a los módulos,
                usuarios, clientes, configuraciones y reportes.
            </p>

        </div>


        <div>

            <h3 style="font-family:Montserrat;">
                Empleado
            </h3>

            <p style="color:#666; font-size:14px;">
                Puede gestionar clientes, rutinas,
                asistencia y consultar reportes.
            </p>

        </div>


        <div>

            <h3 style="font-family:Montserrat;">
                Cliente
            </h3>

            <p style="color:#666; font-size:14px;">
                Puede consultar su información,
                rutinas y asistencia.
            </p>

        </div>

    </div>

</div>