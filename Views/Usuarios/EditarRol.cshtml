@model KROTraining.Models.ConfigurarPermisosViewModel

@{
    ViewData["Title"] = "Configurar permisos";
}

<div class="kro-page-title">
    Configurar permisos
</div>

<p class="kro-page-subtitle">
    Seleccione los permisos asociados al rol.
</p>

<form asp-controller="Usuarios"
      asp-action="EditarRol"
      asp-route-id="@Model.RolId"
      method="post">

    <input asp-for="RolId" type="hidden" />

    <div asp-validation-summary="All"
         role="alert"
         style="color:#B71C1C; margin-bottom:16px;">
    </div>

    <div class="kro-card">
        <div class="kro-card-title">
            Información del rol
        </div>

        <div class="kro-form-group">
            <label for="nombreRol" class="kro-form-label">
                Nombre del rol
            </label>

            <input id="nombreRol"
                   type="text"
                   class="kro-form-control"
                   value="@Model.NombreRol"
                   readonly />
        </div>

        <p style="color:#666; font-size:14px; margin-bottom:0;">
            Esta pantalla configura los permisos del rol.
            Su nombre se conserva.
        </p>
    </div>

    <div class="kro-card">
        <div class="kro-card-title">
            Acciones y permisos
        </div>

        <p style="color:#666; font-size:14px;">
            Marque los permisos que desea asignar y desmarque
            los que desea retirar.
        </p>

        @if (Model.PermisosDisponibles.Count == 0)
        {
            <p role="status">
                No hay permisos registrados en el catálogo.
            </p>
        }
        else
        {
            <div style="display:grid;
                grid-template-columns:repeat(auto-fit, minmax(min(100%, 280px), 1fr));
                gap:16px;">

                @foreach (var permiso in Model.PermisosDisponibles)
                {
                    var seleccionado =
                        Model.PermisosSeleccionados.Contains(permiso.PermisoId);

                    <div class="kro-permission-module"
                         style="padding:18px;
                        border:1px solid #DDD;
                        border-radius:8px;">

                        <label for="permiso-@permiso.PermisoId"
                               style="display:flex;
                            align-items:flex-start;
                            gap:10px;
                            cursor:pointer;">

                            <input id="permiso-@permiso.PermisoId"
                                   type="checkbox"
                                   name="PermisosSeleccionados"
                                   value="@permiso.PermisoId"
                                   checked="@seleccionado"
                                   style="margin-top:3px;
                            accent-color:#D62828;" />

                            <span>
                                <strong style="overflow-wrap:anywhere;">
                                    @permiso.Nombre
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(permiso.Descripcion))
                                {
                                    <span style="display:block;
                                        margin-top:6px;
                                        color:#666;
                                        font-size:14px;
                                        line-height:1.5;">
                                        @permiso.Descripcion
                                    </span>
                                }
                            </span>
                        </label>
                    </div>
                }
            </div>
        }

        <div class="kro-actions"
             style="display:flex;
            justify-content:flex-end;
            flex-wrap:wrap;
            gap:12px;
            margin-top:24px;">

            <a asp-controller="Usuarios"
               asp-action="Roles"
               class="kro-btn kro-btn-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="kro-btn kro-btn-primary"
                    disabled="@(Model.PermisosDisponibles.Count == 0)">
                Guardar cambios
            </button>
        </div>
    </div>
</form>