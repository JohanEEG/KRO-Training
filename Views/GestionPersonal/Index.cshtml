@model System.Collections.Generic.List<KROTraining.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de personal";
}

<h1 class="kro-page-title">
    Gestión de personal
</h1>
<p class="kro-page-subtitle">
    Consulte los colaboradores registrados y administre su información.
</p>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div class="alert alert-success" role="alert">
        @mensaje
    </div>
}

@if (TempData["Error"] is string mensajeError)
{
    <div role="alert" class="kro-profile-alert kro-profile-error">
        <span class="kro-alert-icon" aria-hidden="true">!</span>
        <span>@mensajeError</span>
    </div>
}

<div class="kro-card">

    <div style="display:flex; justify-content:space-between;
        align-items:center; gap:16px; flex-wrap:wrap;
        margin-bottom:20px;">

        <h2 class="kro-card-title" style="margin:0;">
            Colaboradores registrados
        </h2>

        <a asp-controller="GestionPersonal"
           asp-action="Crear"
           class="kro-btn kro-btn-primary">
            + Nuevo colaborador
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <p role="status">
            No hay colaboradores registrados.
        </p>
    }
    else
    {
        <div class="kro-table-container">
            <table class="kro-table">
                <thead>
                    <tr>
                        <th scope="col">Nombre</th>
                        <th scope="col">Correo</th>
                        <th scope="col">Teléfono</th>
                        <th scope="col">Rol</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var colaborador in Model)
                    {
                        bool estaActivo = colaborador.Estado == "ACTIVO";

                        <tr>
                            <td>@colaborador.Nombre</td>
                            <td>@colaborador.Correo</td>
                            <td>@(colaborador.Telefono ?? "—")</td>
                            <td>@colaborador.Rol.Nombre</td>
                            <td>
                                <span class="badge @(estaActivo ? "bg-success" : "bg-danger")">
                                    @colaborador.Estado
                                </span>
                            </td>
                            <td>
                                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                    <a asp-controller="GestionPersonal"
                                       asp-action="Editar"
                                       asp-route-id="@colaborador.UsuarioId"
                                       class="kro-btn kro-btn-small kro-btn-outline"
                                       aria-label="@($"Editar a {colaborador.Nombre}")">
                                        Editar
                                    </a>

