@model KROTraining.Models.RegistrarColaboradorViewModel

@{
    ViewData["Title"] = "Registrar colaborador";
}

<h1 class="kro-page-title">
    Registrar colaborador
</h1>

<p class="kro-page-subtitle">
    Incorpore entrenadores y administradores al sistema.
</p>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div role="status"
         style="padding:16px; margin-bottom:20px;
        background:#E8F5E9; color:#205723;
        border:1px solid #A5D6A7; border-radius:8px;">
        @mensaje
    </div>
}

<div class="kro-card">
    <h2 class="kro-card-title">
        Información del colaborador
    </h2>

    <p>
        Los campos marcados con * son obligatorios.
    </p>

    <form asp-controller="GestionPersonal"
          asp-action="Crear"
          method="post">

        <div asp-validation-summary="All"
             role="alert"
             style="color:#B71C1C; margin-bottom:20px;">
        </div>

        <div class="kro-form-grid">

            <div class="kro-form-group">
                <label asp-for="Nombre" class="kro-form-label">
                    Nombre completo *
                </label>

                <input asp-for="Nombre"
                       class="kro-form-control"
                       autocomplete="name"
                       maxlength="150"
                       required />

                <span asp-validation-for="Nombre"
                      style="color:#B71C1C;"></span>
            </div>

            <div class="kro-form-group">
                <label asp-for="Correo" class="kro-form-label">
                    Correo electrónico *
                </label>

                <input asp-for="Correo"
                       type="email"
                       class="kro-form-control"
                       autocomplete="email"
                       maxlength="150"
                       required />

                <span asp-validation-for="Correo"
                      style="color:#B71C1C;"></span>
            </div>

            <div class="kro-form-group">
                <label asp-for="Telefono"
                       class="kro-form-label"></label>

                <input asp-for="Telefono"
                       type="tel"
                       class="kro-form-control"
                       autocomplete="tel"
                       maxlength="30" />

                <span asp-validation-for="Telefono"
                      style="color:#B71C1C;"></span>
            </div>

            <div class="kro-form-group">
                <label asp-for="RolId" class="kro-form-label">
                    Rol *
                </label>

                <select asp-for="RolId"
                        asp-items="ViewBag.Roles"
                        class="kro-form-control"
                        required>
                    <option value="">Seleccione un rol</option>
                </select>

                <span asp-validation-for="RolId"
                      style="color:#B71C1C;"></span>

                <small style="display:block; margin-top:8px;">
                    El rol ADMINISTRADOR concede acceso administrativo.
                </small>
            </div>

            <div class="kro-form-group">
                <label asp-for="Contrasena" class="kro-form-label">
                    Contraseña *
                </label>

                <input asp-for="Contrasena"
                       type="password"
                       class="kro-form-control"
                       autocomplete="new-password"
                       required />

                <span asp-validation-for="Contrasena"
                      style="color:#B71C1C;"></span>
            </div>

            <div class="kro-form-group">
                <label asp-for="ConfirmarContrasena"
                       class="kro-form-label">
                    Confirmar contraseña *
                </label>

                <input asp-for="ConfirmarContrasena"
                       type="password"
                       class="kro-form-control"
                       autocomplete="new-password"
                       required />

                <span asp-validation-for="ConfirmarContrasena"
                      style="color:#B71C1C;"></span>
            </div>

        </div>

        <div class="kro-actions">
            <a asp-controller="GestionPersonal"
               asp-action="Index"
               class="kro-btn kro-btn-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="kro-btn kro-btn-primary">
                Registrar colaborador
            </button>
        </div>
    </form>
</div>
