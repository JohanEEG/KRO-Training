@{
    ViewData["Title"] = "Membresías Próximas a Vencer";
}

<div class="kro-page-title">
    Membresías próximas a vencer
</div>

<p class="kro-page-subtitle">
    Consulte las membresías que están próximas a finalizar para gestionar su renovación.
