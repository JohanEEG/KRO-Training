            MEMBRESÍAS RENOVADAS
        </h3>

        <strong>
            18
        </strong>

    </div>


    <div class="kro-stat-card">

        <h3>
            MEMBRESÍAS NUEVAS
        </h3>

        <strong>
            6
        </strong>

    </div>

</div>


<div class="kro-card">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">

        <div class="kro-card-title" style="margin:0;">
            Detalle de pagos
        </div>

        <button type="button"
                class="kro-btn kro-btn-outline"
                onclick="alert('Reporte exportado correctamente.');">
