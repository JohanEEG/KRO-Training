@{
    ViewData["Title"] = "Reporte de Pagos";
}

<div class="kro-page-title">
    Reporte de pagos e ingresos
</div>

<p class="kro-page-subtitle">
    Consulte los ingresos generados por concepto de membresías durante un periodo determinado.
</p>


<div class="kro-card">

    <div class="kro-card-title">
        Parámetros del reporte
    </div>


    <div class="kro-form-grid">

        <div class="kro-form-group">

            <label class="kro-form-label">
                Fecha inicial
            </label>

            <input type="date"
                   class="kro-form-control"
                   value="2026-08-01" />

        </div>


        <div class="kro-form-group">

            <label class="kro-form-label">
                Fecha final
            </label>

            <input type="date"
                   class="kro-form-control"
                   value="2026-08-17" />

        </div>


        <div class="kro-form-group">

            <label class="kro-form-label">
                Tipo de reporte
            </label>

            <select class="kro-form-control">

                <option>Pagos e ingresos</option>
                <option>Pagos por membresía</option>
                <option>Ingresos por periodo</option>

            </select>

        </div>

    </div>


    <div class="kro-actions">

        <button type="button"
                class="kro-btn kro-btn-primary"
                onclick="alert('Reporte generado correctamente.');">
            Generar reporte
        </button>

    </div>

</div>


<div class="kro-stat-grid">

    <div class="kro-stat-card">

        <h3>
            INGRESOS DEL PERIODO
        </h3>

        <strong>
            ₡485.000
        </strong>

    </div>


    <div class="kro-stat-card">

