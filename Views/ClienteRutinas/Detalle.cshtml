
@model KROTraining.ViewModels.ClienteSesionViewModel

@{
    ViewData["Title"] = "Detalle de sesión";
    var porcentaje = Model.TotalEjercicios == 0
        ? 0
        : (int)Math.Round(
            Model.EjerciciosCompletados * 100.0 / Model.TotalEjercicios);
}

<div class="kro-page-title">Detalle de sesión histórica</div>
<p class="kro-page-subtitle">
    Revisá los resultados de tu entrenamiento.
</p>

<div class="kro-card mb-3">
    <h3>@Model.NombreRutina</h3>
    <p><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
    <p>
        <strong>Estado:</strong>
        @(Model.Estado == "FINALIZADA" ? "Finalizada" : "En progreso")
    </p>
    <p>
        <strong>Ejercicios completados:</strong>
        @Model.EjerciciosCompletados de @Model.TotalEjercicios
    </p>

    <div class="progress" role="progressbar"
         aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width: @porcentaje%">
            @porcentaje%
        </div>
    </div>
</div>

<div class="kro-card">
    <h4>Resultado por ejercicio</h4>

    @if (Model.Ejercicios.Count == 0)
    {
        <p>Esta sesión no contiene ejercicios registrados.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Ejercicio</th>
                        <th>Grupo muscular</th>
                        <th>Series</th>
                        <th>Repeticiones</th>
                        <th>Descanso</th>
                        <th>Resultado</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var ejercicio in Model.Ejercicios)
                {
                    <tr>
                        <td>@ejercicio.Nombre</td>
                        <td>@(ejercicio.GrupoMuscular ?? "—")</td>
                        <td>@(ejercicio.SeriesAsignadas?.ToString() ?? "—")</td>
                        <td>@(ejercicio.RepeticionesAsignadas?.ToString() ?? "—")</td>
                        <td>
                            @(ejercicio.DescansoSegundosAsignado?.ToString() ?? "—") s
                        </td>
                        <td>
                            @(ejercicio.Completado ? "Completado" : "No completado")
                            @if (ejercicio.FechaMarcado.HasValue)
                            {
                                <div class="text-muted small">
                                    @ejercicio.FechaMarcado.Value.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="mt-3 d-flex flex-wrap gap-2">
    <a asp-action="Historial" class="kro-btn kro-btn-secondary">
        Volver al historial
    </a>

    @if (Model.Estado == "EN_PROGRESO")
    {
        <a asp-action="Sesion" asp-route-id="@Model.SesionId"
           class="kro-btn kro-btn-primary">
            Continuar sesión
        </a>
    }
</div>
