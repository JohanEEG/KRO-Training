
@model IEnumerable<KROTraining.ViewModels.ClienteHistorialItemViewModel>

@{
    ViewData["Title"] = "Historial de rutinas";
}

<div class="kro-page-title">Mi historial de entrenamiento</div>
<p class="kro-page-subtitle">
    Consultá las sesiones registradas y revisá tu progreso.
</p>

<div class="kro-card">
    @if (!Model.Any())
    {
        <h4>Sin historial disponible</h4>
        <p>
            Todavía no tenés sesiones registradas.
            Cuando comencés tu primer entrenamiento, aparecerá aquí.
        </p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Rutina</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Ejercicios completados</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var sesion in Model)
                {
                    <tr>
                        <td>@sesion.NombreRutina</td>
                        <td>@sesion.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @(sesion.Estado == "FINALIZADA"
                                ? "Finalizada"
                                : "En progreso")
                        </td>
                        <td>
                            @sesion.EjerciciosCompletados de @sesion.TotalEjercicios
                        </td>
                        <td>
                            <a asp-action="Detalle"
                               asp-route-id="@sesion.SesionId"
                               class="kro-btn kro-btn-small kro-btn-secondary">
                                Ver detalle
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="mt-3">
    <a asp-action="Index" class="kro-btn kro-btn-secondary">
        Volver a mi rutina
    </a>
</div>
