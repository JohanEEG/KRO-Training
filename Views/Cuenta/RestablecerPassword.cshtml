@model KROTraining.Models.RestablecerPasswordViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Restablecer contraseña - KRÒ Training</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/kro-training.css" />
</head>
<body>
    <div class="kro-login-page">
        <div class="kro-login-card">
            <div class="kro-login-logo">
                <h1>KR<span>Ò</span></h1>
                <strong>TRAINING</strong>
            </div>

            <div class="kro-card-title" style="text-align:center;">
                Nueva contraseña
            </div>

            @if (TempData["Mensaje"] != null)
            {
                <div style="background-color: #d1e7dd; color: #0f5132; padding: 10px; border-radius: 5px; margin-bottom: 20px; font-size: 13px; text-align: center; font-family: 'Roboto', sans-serif;">
                    @TempData["Mensaje"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div style="background-color: #f8d7da; color: #842029; padding: 10px; border-radius: 5px; margin-bottom: 20px; font-size: 13px; text-align: center; font-family: 'Roboto', sans-serif;">
                    @TempData["Error"]
                </div>
            }

            <p style="text-align:center; color:#666; font-size:14px; margin-bottom:25px; font-family:'Roboto', sans-serif;">
                Ingrese su nueva contraseña de acceso para la cuenta.
            </p>

            <!-- Formulario conectado a la acción POST de RestablecerPassword usando el ViewModel -->
            <form asp-controller="Cuenta" asp-action="RestablecerPassword" method="post">
                @Html.AntiForgeryToken()

                <!-- Campo oculto para conservar y enviar el correo de forma segura -->
                <input type="hidden" asp-for="Correo" />

                <div class="kro-form-group">
                    <label class="kro-form-label">Nueva contraseña</label>
                    <input type="password"
                           asp-for="NuevaContrasena"
                           class="kro-form-control"
                           placeholder="Mínimo 6 caracteres"
                           required />
                </div>

                <div class="kro-form-group" style="margin-top: 15px;">
                    <label class="kro-form-label">Confirmar nueva contraseña</label>
                    <input type="password"
                           asp-for="ConfirmarContrasena"
                           class="kro-form-control"
                           placeholder="Repita la contraseña"
                           required />
                </div>

                <button type="submit"
                        class="kro-btn kro-btn-primary"
                        style="width:100%; margin-top: 20px;">
                    Guardar nueva contraseña
                </button>
            </form>

            <div style="text-align:center; margin-top:20px;">
                <a href="/Cuenta/Login" class="kro-login-link">
                    ← Volver al inicio de sesión
                </a>
            </div>
        </div>
    </div>
</body>
</html>