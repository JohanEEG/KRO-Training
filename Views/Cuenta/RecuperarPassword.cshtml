@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar contraseña - KRÒ Training</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/kro-training.css" />
</head>
<body>
    <div class="kro-login-page">
        <div class="kro-login-card">
            <div class="kro-login-logo">
                <h1>KR<span>Ò</span></h1>
                <strong>TRAINING</strong>
            </div>

            <div class="kro-card-title" style="text-align:center;">
                Recuperar contraseña
            </div>

            <!-- Alerta de éxito cuando ya se envió el correo -->
            @if (TempData["Mensaje"] != null)
            {
                <div style="background-color: #d1e7dd; color: #0f5132; padding: 15px; border-radius: 5px; margin-bottom: 20px; font-size: 14px; text-align: center; font-family: 'Roboto', sans-serif; line-height: 1.4;">
                    @TempData["Mensaje"]
                </div>

                <!-- Botón para regresar al login después de enviar el correo con éxito -->
                <div style="margin-top: 25px;">
                    <a href="/Cuenta/Login" class="kro-btn kro-btn-primary" style="display: block; text-align: center; text-decoration: none; line-height: normal;">
                        Ir al inicio de sesión
                    </a>
                </div>
            }
            else
            {
                <!-- Alerta de error si el correo no existe -->
                @if (TempData["Error"] != null)
                {
                    <div style="background-color: #f8d7da; color: #842029; padding: 10px; border-radius: 5px; margin-bottom: 20px; font-size: 13px; text-align: center; font-family: 'Roboto', sans-serif;">
                        @TempData["Error"]
                    </div>
                }

                <p style="text-align:center; color:#666; font-size:14px; margin-bottom:25px; font-family:'Roboto', sans-serif;">
                    Ingrese su correo electrónico registrado y le enviaremos las instrucciones para restablecer su contraseña.
                </p>

                <!-- Formulario POST que se queda en la misma vista mostrando el mensaje -->
                <form asp-controller="Cuenta" asp-action="RecuperarPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="kro-form-group">
                        <label class="kro-form-label">Correo electrónico</label>
                        <input type="email"
                               name="correo"
                               class="kro-form-control"
                               placeholder="ejemplo@correo.com"
                               required />
                    </div>

                    <button type="submit"
                            class="kro-btn kro-btn-primary"
                            style="width:100%; margin-top: 20px;">
                        Enviar instrucciones
                    </button>
                </form>

                <div style="text-align:center; margin-top:20px;">
                    <a href="/Cuenta/Login" class="kro-login-link">
                        ← Volver al inicio de sesión
                    </a>
                </div>
            }
        </div>
    </div>
</body>
</html>