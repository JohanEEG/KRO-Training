@{
    ViewData["Title"] = "Iniciar Sesión";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Iniciar sesión - KRÒ Training</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Roboto:wght@400;500&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/kro-training.css" />

</head>

<body>

    <div class="kro-login-page">

        <div class="kro-login-card">

            <div class="kro-login-logo">

                <h1>
                    KR<span>Ò</span>
                </h1>

                <strong>
                    TRAINING
                </strong>

            </div>


            <div class="kro-card-title"
                 style="text-align:center;">

                Iniciar sesión

            </div>


            <form>

                <div class="kro-form-group">

                    <label class="kro-form-label">
                        Usuario
                    </label>

                    <input type="text"
                           class="kro-form-control"
                           placeholder="Ingrese su usuario" />

                </div>


                <div class="kro-form-group">

                    <label class="kro-form-label">
                        Contraseña
                    </label>

                    <input type="password"
                           class="kro-form-control"
                           placeholder="Ingrese su contraseña" />

                </div>


                <div style="text-align:right; margin-bottom:20px;">

                    <a href="/Cuenta/RecuperarPassword"
                       class="kro-login-link">

                        ¿Olvidaste tu contraseña?

                    </a>

                </div>


                <button type="button"
                        class="kro-btn kro-btn-primary"
                        style="width:100%;"
                        onclick="window.location.href='/Home/Index';">

                    Iniciar sesión

                </button>

            </form>


            <div style="text-align:center; margin-top:25px; color:#777; font-size:13px;">

                Sistema de gestión

                <br />

                <strong>KRÒ Training</strong>

            </div>

        </div>

    </div>

</body>

</html>