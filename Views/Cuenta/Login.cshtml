@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión - KRÒ Training</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/kro-training.css" />
</head>
<body>

    <div class="kro-login-page">

        <div class="kro-login-card">

            <div class="kro-login-logo">
                <h1>
                    KR<span>Ò</span>
                </h1>
                <strong>
                    TRAINING
                </strong>
            </div>

            <div class="kro-card-title" style="text-align:center;">
                Iniciar sesión
            </div>

            <!-- Formulario conectado al controlador Cuenta y acción Login -->
            <form asp-controller="Cuenta" asp-action="Login" method="post">

                <!-- Resumen por si las credenciales fallan -->
                <div asp-validation-summary="ModelOnly" class="text-danger" style="text-align:center; margin-bottom:15px; font-size:13px;"></div>

                <div class="kro-form-group">
                    <label class="kro-form-label">
                        Correo electrónico
                    </label>
                    <input type="email"
                           name="correo"
                           class="kro-form-control"
                           placeholder="Ingrese su correo"
                           required />
                </div>

                <div class="kro-form-group">
                    <label class="kro-form-label">
                        Contraseña
                    </label>
                    <input type="password"
                           name="contrasena"
                           class="kro-form-control"
                           placeholder="Ingrese su contraseña"
                           required />
                </div>

                <div style="text-align:right; margin-bottom:20px;">
                    <a href="/Cuenta/RecuperarPassword"
                       class="kro-login-link">
                        ¿Olvidaste tu contraseña?
                    </a>
                </div>

                <!-- Cambiado a type="submit" para que procese el envío del formulario -->
                <button type="submit"
                        class="kro-btn kro-btn-primary"
                        style="width:100%;">
                    Iniciar sesión
                </button>

            </form>

            <!-- Opción para registrarse -->
            <div style="text-align:center; margin-top:20px; font-size:14px; font-family:'Roboto', sans-serif;">
                <span style="color:#666;">¿No tienes una cuenta?</span>
                <a href="/Cuenta/Registro" class="kro-login-link" style="display:inline-block; margin-top:5px; font-weight:600;">
                    Crear cuenta
                </a>
            </div>

            <div style="text-align:center; margin-top:25px; color:#777; font-size:13px;">
                Sistema de gestión
                <br />
                <strong>KRÒ Training</strong>
            </div>

        </div>

    </div></body>
</html>