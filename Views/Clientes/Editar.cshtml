@model KROTraining.Models.Cliente

@{
    ViewData["Title"] = "Modificar Cliente";
}

<div class="kro-page-title">Modificar información del cliente</div>
<p class="kro-page-subtitle">Actualice los datos personales del cliente seleccionado.</p>

<div class="kro-card">
    <div class="kro-card-title">Información del cliente</div>

    <form asp-action="Editar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="UsuarioId" value="@Model.UsuarioId" />

        <div class="kro-form-grid">
            <div class="kro-form-group">
                <label class="kro-form-label">Cédula</label>
                <input type="text" name="Cedula" class="kro-form-control" value="@Model.Usuario?.Cedula" placeholder="Ej. 1-1111-1111" required />
            </div>

            <div class="kro-form-group">
                <label class="kro-form-label">Número de Badge / Carné</label>
                <input type="text" name="BadgeNumero" class="kro-form-control" value="@Model.BadgeNumero" placeholder="Ej. BDG-00123" />
            </div>

            <div class="kro-form-group">
                <label class="kro-form-label">Nombre Completo</label>
                <input type="text" name="Nombre" class="kro-form-control" value="@Model.Usuario?.Nombre" required />
            </div>

            <div class="kro-form-group">
                <label class="kro-form-label">Teléfono</label>
                <input type="tel" name="Telefono" class="kro-form-control" value="@Model.Usuario?.Telefono" />
            </div>

            <div class="kro-form-group">
                <label class="kro-form-label">Correo electrónico</label>
                <input type="email" name="Correo" class="kro-form-control" value="@Model.Usuario?.Correo" required />
            </div>
        </div>

        <div class="kro-actions">
            <a asp-action="Index" class="kro-btn kro-btn-secondary">Cancelar</a>
            <button type="submit" class="kro-btn kro-btn-primary">Guardar cambios</button>
        </div>
    </form>
</div>