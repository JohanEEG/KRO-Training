@model IEnumerable<KROTraining.Models.Cliente>

@{
    ViewData["Title"] = "Gestión de Clientes";
}

<div class="kro-page-title">Gestión de Clientes</div>
<p class="kro-page-subtitle">Consulta y administra la información de los clientes registrados en KRÒ Training.</p>

<div class="kro-card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <div class="kro-card-title" style="margin:0;">Clientes registrados</div>
        <a asp-action="Crear" class="kro-btn kro-btn-primary">+ Nuevo cliente</a>
    </div>

    <!-- BARRA DE BÚSQUEDA -->
    <form method="get" asp-action="Index" class="kro-search" style="display: flex; gap: 10px; margin-bottom: 20px;">
        <input type="text" 
               name="buscar" 
               value="@Context.Request.Query["buscar"]" 
               class="kro-form-control" 
               placeholder="Buscar por nombre, cédula o N° de badge..." />

        <button type="submit" class="kro-btn kro-btn-secondary">🔍 Buscar</button>
        <a asp-action="Index" class="kro-btn kro-btn-outline">Limpiar</a>
    </form>

    <!-- TABLA DE CLIENTES -->
    <div class="kro-table-container">
        <table class="kro-table">
            <thead>
                <tr>
                    <th>Cédula</th>
                    <th>N° Badge</th>
                    <th>Nombre Completo</th>
                    <th>Teléfono</th>
                    <th>Correo Electrónico</th>
                    <th>Estado</th>
                    <th style="text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 20px; color: #666;">
                            No se encontraron clientes registrados o que coincidan con la búsqueda.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(item.Usuario != null && !string.IsNullOrEmpty(item.Usuario.Cedula) ? item.Usuario.Cedula : "-")</td>
                            <td>@(string.IsNullOrEmpty(item.BadgeNumero) ? "-" : item.BadgeNumero)</td>
                            <td>@(item.Usuario != null ? item.Usuario.Nombre : "Sin usuario")</td>
                            <td>@(item.Usuario != null ? item.Usuario.Telefono : "-")</td>
                            <td>@(item.Usuario != null ? item.Usuario.Correo : "-")</td>
                            <td>
                                @if (item.Usuario != null && item.Usuario.Estado == "Activo")
                                {
                                    <span class="kro-badge kro-badge-green">Activo</span>
                                }
                                else
                                {
                                    <span class="kro-badge kro-badge-gray">Inactivo</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                <div class="kro-table-actions" style="display: flex; gap: 5px; justify-content: center;">
                                    <!-- Botón Editar -->
                                    <a asp-action="Editar" asp-route-id="@item.UsuarioId" class="kro-btn kro-btn-small kro-btn-outline">
                                        Editar
                                    </a>

                                    <!-- Botón Activar / Desactivar -->
                                    @if (item.Usuario != null && item.Usuario.Estado == "Activo")
                                    {
                                        <form asp-action="Desactivar" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.UsuarioId" />
                                            <button type="submit" 
                                                    class="kro-btn kro-btn-small kro-btn-danger" 
                                                    onclick="return confirm('¿Está seguro de desactivar a este cliente?');">
                                                Desactivar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Reactivar" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.UsuarioId" />
                                            <button type="submit" 
                                                    class="kro-btn kro-btn-small kro-btn-success" 
                                                    onclick="return confirm('¿Desea reactivar a este cliente?');">
                                                Activar
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>