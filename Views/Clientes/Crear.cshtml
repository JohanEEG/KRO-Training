@{
    ViewData["Title"] = "Registrar Cliente";
}

<div class="kro-page-title">
    Registrar nuevo cliente
</div>

<p class="kro-page-subtitle">
    Complete la información personal del nuevo cliente.
</p>

<div class="kro-card">

    <div class="kro-card-title">
        Información personal
    </div>

    <form>

        <div class="kro-form-grid">

            <div class="kro-form-group">

                <label class="kro-form-label">
                    Nombre
                </label>

                <input type="text"
                       class="kro-form-control"
                       placeholder="Ingrese el nombre" />

            </div>


            <div class="kro-form-group">

                <label class="kro-form-label">
                    Primer apellido
                </label>

                <input type="text"
                       class="kro-form-control"
                       placeholder="Ingrese el primer apellido" />

            </div>


            <div class="kro-form-group">

                <label class="kro-form-label">
                    Segundo apellido
                </label>

                <input type="text"
                       class="kro-form-control"
                       placeholder="Ingrese el segundo apellido" />

            </div>


            <div class="kro-form-group">

                <label class="kro-form-label">
                    Cédula
                </label>

                <input type="text"
                       class="kro-form-control"
                       placeholder="Ej. 1-1111-1111" />

            </div>


            <div class="kro-form-group">

                <label class="kro-form-label">
                    Fecha de nacimiento
                </label>

                <input type="date"
                       class="kro-form-control" />

            </div>


            <div class="kro-form-group">

                <label class="kro-form-label">
                    Teléfono
                </label>

                <input type="tel"
                       class="kro-form-control"
                       placeholder="Ej. 8888-8888" />

            </div>


            <div class="kro-form-group">

                <label class="kro-form-label">
                    Correo electrónico
                </label>

                <input type="email"
                       class="kro-form-control"
                       placeholder="correo@ejemplo.com" />

            </div>


            <div class="kro-form-group">

                <label class="kro-form-label">
                    Provincia
                </label>

                <select class="kro-form-control">

                    <option>Seleccione una provincia</option>
                    <option>San José</option>
                    <option>Alajuela</option>
                    <option>Cartago</option>
                    <option>Heredia</option>
                    <option>Guanacaste</option>
                    <option>Puntarenas</option>
                    <option>Limón</option>

                </select>

            </div>

        </div>


        <div class="kro-form-group">

            <label class="kro-form-label">
                Dirección
            </label>

            <textarea class="kro-form-control"
                      rows="3"
                      placeholder="Ingrese la dirección del cliente"></textarea>

        </div>


        <div class="kro-actions">

            <a href="/Clientes/Index"
               class="kro-btn kro-btn-secondary">
                Cancelar
            </a>

            <button type="button"
                    class="kro-btn kro-btn-primary"
                    onclick="alert('Cliente registrado correctamente.');">
                Registrar cliente
            </button>

        </div>

    </form>

</div>