@{
    ViewData["Title"] = "Registrar Cliente";
}

<div class="kro-page-title">Registrar nuevo cliente</div>
<p class="kro-page-subtitle">Complete la información del nuevo cliente.</p>

<div class="kro-card">
    <div class="kro-card-title">Información personal</div>

    <form asp-action="Crear" method="post">
        @Html.AntiForgeryToken()
        <div class="kro-form-grid">
            <div class="kro-form-group">
                <label class="kro-form-label">Nombre</label>
                <input type="text" name="Nombre" class="kro-form-control" placeholder="Ingrese el nombre" required />
            </div>

            <div class="kro-form-group">
                <label class="kro-form-label">Primer apellido</label>
                <input type="text" name="PrimerApellido" class="kro-form-control" placeholder="Ingrese el primer apellido" required />
            </div>

            <div class="kro-form-group">
                <label class="kro-form-label">Segundo apellido</label>
                <input type="text" name="SegundoApellido" class="kro-form-control" placeholder="Ingrese el segundo apellido" />
            </div>

            <div class="kro-form-group">
                <label class="kro-form-label">Cédula</label>
                <input type="text" name="Cedula" class="kro-form-control" placeholder="Ej. 1-1111-1111" required />
            </div>

            <div class="kro-form-group">
                <label class="kro-form-label">Número de Badge / Carné</label>
                <input type="text" name="BadgeNumero" class="kro-form-control" placeholder="Ej. BDG-00123" />
            </div>

            <div class="kro-form-group">
                <label class="kro-form-label">Teléfono</label>
                <input type="tel" name="Telefono" class="kro-form-control" placeholder="Ej. 8888-8888" />
            </div>

            <div class="kro-form-group">
                <label class="kro-form-label">Correo electrónico</label>
                <input type="email" name="Correo" class="kro-form-control" placeholder="correo@ejemplo.com" required />
            </div>
        </div>

        <div class="kro-actions">
            <a asp-action="Index" class="kro-btn kro-btn-secondary">Cancelar</a>
            <button type="submit" class="kro-btn kro-btn-primary">Registrar cliente</button>
        </div>
    </form>
</div>