@{
    ViewData["Title"] = "Inicio";
    var nombre = User.Identity?.Name ?? "";
}

<div class="kro-page-title">
    Bienvenido, @nombre
</div>

@if (User.IsInRole("ADMINISTRADOR"))
{
    <p class="kro-page-subtitle">
        Panel de administración de KRÒ Training.
    </p>

    <div class="kro-card">

        <div class="kro-card-title">
            Accesos rápidos
        </div>

        <div style="display:flex; gap:15px; flex-wrap:wrap;">

            <a href="/Clientes/Crear"
               class="kro-btn kro-btn-primary">

                + Registrar cliente

            </a>


            <a href="/Clientes/Index"
               class="kro-btn kro-btn-secondary">

                👥 Consultar clientes

            </a>


            <a href="/Usuarios/Crear"
               class="kro-btn kro-btn-outline">

                + Registrar usuario

            </a>

        </div>

    </div>
}
else if (User.IsInRole("ENTRENADOR"))
{
    <p class="kro-page-subtitle">
        Gestiona tus clientes y sus rutinas desde el menú lateral.
    </p>
}
else if (User.IsInRole("CLIENTE"))
{
    <p class="kro-page-subtitle">
        Consulta tu rutina y registra tu ingreso desde el menú lateral.
    </p>
}
else
{
    <p class="kro-page-subtitle">
        Bienvenido al sistema de gestión de KRÒ Training.
    </p>
}
