@model KROTraining.Models.RegistrarMedidasViewModel

@{
    ViewData["Title"] = "Registrar mis medidas";
}

<div class="kro-page-title">
    Registrar mis medidas corporales
</div>

<p class="kro-page-subtitle">
    Registre sus medidas para llevar un control de su progreso.
    Los campos con asterisco (*) son obligatorios.
</p>

@if (TempData["MensajeExito"] is string mensaje)
{
    <div role="status"
         style="background:#E8F5E9; color:#1B5E20;
        border-left:4px solid #2E7D32;
        padding:16px; border-radius:8px; margin-bottom:20px;">
        @mensaje
    </div>
}

<div class="kro-card" style="max-width:850px; margin:0 auto;">
    <div class="kro-card-title">
        Mis medidas
    </div>

    <p>
        La fecha del registro se guardará automáticamente.
        Puede ingresar hasta dos decimales.
    </p>

    <form asp-controller="MisMedidas"
          asp-action="Registrar"
          method="post">

        <div asp-validation-summary="All"
             role="alert"
             style="color:#B42318; margin-bottom:16px;">
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Peso" class="kro-form-label">
                    Peso (kg) *
                </label>

                <input asp-for="Peso"
                       type="number"
                       min="1"
                       max="700"
                       step="0.01"
                       required
                       class="kro-form-control"
                       placeholder="Ej. 64" />

                <span asp-validation-for="Peso"
                      style="color:#B42318;"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Estatura" class="kro-form-label">
                    Estatura (m) *
                </label>

                <input asp-for="Estatura"
                       type="number"
                       min="0.30"
                       max="3.00"
                       step="0.01"
                       required
                       class="kro-form-control"
                       placeholder="Ej. 1.80" />

                <small>
                    Ingrese la estatura en metros: para 180 cm, escriba 1,80.
                </small>

                <span asp-validation-for="Estatura"
                      style="color:#B42318;"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Cintura" class="kro-form-label"></label>

                <input asp-for="Cintura"
                       type="number"
                       min="1"
                       max="300"
                       step="0.01"
                       class="kro-form-control"
                       placeholder="Opcional. Ej. 80" />

                <span asp-validation-for="Cintura"
                      style="color:#B42318;"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Cadera" class="kro-form-label"></label>

                <input asp-for="Cadera"
                       type="number"
                       min="1"
                       max="300"
                       step="0.01"
                       class="kro-form-control"
                       placeholder="Opcional. Ej. 95" />

                <span asp-validation-for="Cadera"
                      style="color:#B42318;"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Brazo" class="kro-form-label"></label>

                <input asp-for="Brazo"
                       type="number"
                       min="1"
                       max="150"
                       step="0.01"
                       class="kro-form-control"
                       placeholder="Opcional. Ej. 32" />

                <span asp-validation-for="Brazo"
                      style="color:#B42318;"></span>
            </div>
        </div>

        <div style="display:flex; justify-content:flex-end;
            margin-top:24px;">
            <button type="submit" class="kro-btn kro-btn-primary">
                Guardar mis medidas
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
