@model IEnumerable<KROTraining.Models.EvaluacionFisica>

@{
    ViewData["Title"] = "Progreso Físico";
    var cliente = ViewBag.Cliente as KROTraining.Models.Cliente;
    var observaciones = ViewBag.Observaciones as List<KROTraining.Models.ObservacionEntrenador>;

    // Obtener la última evaluación y la inicial para los cálculos rápidos
    var ultimaEval = Model?.OrderByDescending(e => e.Fecha).FirstOrDefault();
    var primeraEval = Model?.OrderBy(e => e.Fecha).FirstOrDefault();
}

<div class="kro-page-title">
    Progreso físico
</div>
<p class="kro-page-subtitle">
    Consulte los cambios y evolución física del cliente a partir de sus evaluaciones.
</p>
@if (TempData["MensajeExito"] is string mensaje)
{
    <div role="status"
         style="background:#E8F5E9; color:#1B5E20;
        border-left:4px solid #2E7D32;
        padding:16px; border-radius:8px; margin-bottom:20px;">
        @mensaje
    </div>
}

@if (cliente != null)
{
    <!-- Cabecera de información del cliente -->
    <div class="kro-card mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="kro-card-title mb-1">
                    <i class="bi bi-person-fill text-primary"></i> @(cliente.Usuario?.Nombre ?? "Cliente")
                </div>
                <p style="margin:0; color:#6B7280; font-size:13px;">
                    <strong>Badge:</strong> @(cliente.BadgeNumero ?? "N/D") |
                    <strong>Nivel:</strong> @(cliente.Nivel ?? "No asignado") |
                    <strong>Objetivo:</strong> @(cliente.Objetivo ?? "No especificado")
                </p>
            </div>
            <div>
                <a asp-controller="Clientes" asp-action="MisClientes" class="kro-btn kro-clients-secondary">
                    <i class="bi bi-arrow-left"></i> Volver a Mis Clientes
                </a>
            </div>
        </div>
    </div>
}

<!-- Tarjetas de Estadísticas (Valores dinámicos basados en la última evaluación) -->
<div class="kro-stat-grid">
    <div class="kro-stat-card">
        <h3>PESO ACTUAL</h3>
        <strong>@(ultimaEval?.Peso.HasValue == true ? $"{ultimaEval.Peso} kg" : "N/D")</strong>
        <p style="margin:8px 0 0;">Última evaluación</p>
    </div>

    <div class="kro-stat-card">
        <h3>ESTATURA</h3>
        <strong>@(ultimaEval?.Estatura.HasValue == true ? $"{ultimaEval.Estatura} m" : "N/D")</strong>
        <p style="margin:8px 0 0;">Última evaluación</p>
    </div>

    <div class="kro-stat-card">
        <h3>TIPO DE EVALUACIÓN</h3>
        <strong>@(ultimaEval?.Tipo ?? "Sin registros")</strong>
        <p style="margin:8px 0 0;">Último control</p>
    </div>

    <div class="kro-stat-card">
        <h3>EVALUACIONES</h3>
        <strong>@(Model?.Count() ?? 0)</strong>
        <p style="margin:8px 0 0;">Registradas</p>
    </div>
</div>

<!-- Tabla de Comparación / Historial -->
<div class="kro-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="kro-card-title m-0">
            Historial de Evaluaciones y Progreso
        </div>
        @if (cliente != null && User.IsInRole("ENTRENADOR"))
        {
            <a asp-controller="SeguimientoFisico"
               asp-action="RegistrarEvaluacion"
               asp-route-clienteId="@cliente.UsuarioId"
               class="kro-btn kro-btn-primary">
                + Registrar evaluación periódica
            </a>
        }
    </div>

    <div class="kro-table-container">
        <table class="kro-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Peso</th>
                    <th>Estatura</th>
                    <th>Medidas / Notas</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4" style="color: #6B7280;">
                            <i class="bi bi-clipboard-x fs-3 d-block mb-2"></i>
                            No hay evaluaciones físicas registradas para este cliente.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td>@ev.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="kro-badge kro-badge-green">
                                    @(ev.Tipo ?? "Evaluación")
                                </span>
                            </td>
                            <td><strong>@(ev.Peso.HasValue ? $"{ev.Peso} kg" : "-")</strong></td>
                            <td>@(ev.Estatura.HasValue ? $"{ev.Estatura} m" : "-")</td>
                            <td>
                                <div style="font-size: 13px;">
                                    @if (!string.IsNullOrEmpty(ev.Medidas))
                                    {
                                        <div><strong>Medidas:</strong> @ev.Medidas</div>
                                    }
                                    @if (!string.IsNullOrEmpty(ev.Observaciones))
                                    {
                                        <div style="color: #6B7280;">@ev.Observaciones</div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Sección de Observaciones del Entrenador (HU-81) -->
<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="kro-card h-100">
            <div class="kro-card-title mb-3">Registrar observación de entrenador</div>
            <form asp-action="RegistrarObservacion" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="clienteId" value="@cliente?.UsuarioId" />
                <div class="mb-3">
                    <label for="contenido" class="kro-form-label">Nueva nota u observación</label>
                    <textarea class="kro-form-control" id="contenido" name="contenido" rows="3" required placeholder="Escriba aquí los detalles del avance o recomendaciones..."></textarea>
                </div>
                <button type="submit" class="kro-btn kro-clients-primary w-100 justify-content-center">
                    <i class="bi bi-send"></i> Guardar observación
                </button>
            </form>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="kro-card h-100 d-flex flex-column">
            <div class="kro-card-title mb-3">Historial de observaciones</div>
            <div class="overflow-auto flex-grow-1" style="max-height: 250px;">
                @if (observaciones != null && observaciones.Any())
                {
                    @foreach (var obs in observaciones)
                    {
                        <div class="p-3 mb-2 rounded border bg-light">
                            <div class="d-flex justify-content-between text-muted" style="font-size: 11px;">
                                <span><strong>@(obs.Entrenador?.Usuario?.Nombre ?? "Entrenador")</strong></span>
                                <span>@obs.Fecha.ToString("dd/MM/yyyy")</span>
                            </div>
                            <p class="mb-0 mt-1 text-dark" style="font-size: 13px;">@obs.Contenido</p>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-4 m-0" style="font-size: 13px;">Sin observaciones registradas aún.</p>
                }
            </div>
        </div>
    </div>
</div>

