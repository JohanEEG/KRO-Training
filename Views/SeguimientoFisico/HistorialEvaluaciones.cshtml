@model IEnumerable<KROTraining.Models.Cliente>

@{
    ViewData["Title"] = "Historial de Evaluaciones";
}

<div class="kro-page-title">
    Módulo de Seguimiento Físico
</div>
<p class="kro-page-subtitle">
    Consulte la evolución física de los clientes seleccionando un expediente de la lista.
</p>

<div class="kro-card mb-4">
    <div class="kro-card-title mb-3">
        Seleccionar cliente para seguimiento
    </div>

    <!-- Formulario para buscar o seleccionar rápido -->
    <div class="kro-form-grid" style="display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap;">
        <div class="kro-form-group" style="flex: 1; min-width: 250px;">
            <label class="kro-form-label">Cliente registrado</label>
            <select id="selectClienteId" class="kro-form-control">
                <option value="">Seleccione un cliente...</option>
                @if (Model != null)
                {
                    @foreach (var c in Model)
                    {
                        <option value="@c.UsuarioId">@(c.Usuario?.Nombre ?? "Sin nombre") (Badge: @(c.BadgeNumero ?? "N/D"))</option>
                    }
                }
            </select>
        </div>

        <div class="kro-actions">
            <button type="button"
                    class="kro-btn kro-clients-primary"
                    onclick="irAProgreso()">
                <i class="bi bi-search"></i> Consultar Progreso
            </button>
        </div>
    </div>
</div>

<div class="kro-card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:10px;">
        <div class="kro-card-title" style="margin:0;">
            Listado general de clientes en seguimiento
        </div>
    </div>

    <div class="kro-table-container">
        <table class="kro-table">
            <thead>
                <tr>
                    <th>Badge</th>
                    <th>Cédula</th>
                    <th>Nombre completo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            No hay clientes registrados en el sistema.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        bool activo = c.Usuario?.Estado == "Activo";
                        <tr>
                            <td><strong>@(c.BadgeNumero ?? "N/D")</strong></td>
                            <td>@(c.Usuario?.Cedula ?? "-")</td>
                            <td><span class="fw-semibold text-dark">@(c.Usuario?.Nombre ?? "Sin nombre")</span></td>
                            <td>
                                @if (activo)
                                {
                                    <span class="kro-badge kro-badge-green" style="background:#F0FDF4; color:#166534; padding:4px 8px; border-radius:4px; font-size:11px;">Activo</span>
                                }
                                else
                                {
                                    <span class="kro-badge kro-badge-gray" style="background:#F3F4F6; color:#4B5563; padding:4px 8px; border-radius:4px; font-size:11px;">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="ProgresoFisico" asp-route-id="@c.UsuarioId" class="kro-btn kro-clients-primary" style="padding: 6px 12px; font-size: 12px; text-decoration: none;">
                                    <i class="bi bi-activity"></i> Ver Progreso Físico
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function irAProgreso() {
        var clienteId = document.getElementById("selectClienteId").value;
        if (!clienteId) {
            alert("Por favor seleccione un cliente primero.");
            return;
        }
        window.location.href = '/SeguimientoFisico/ProgresoFisico/' + clienteId;
    }
</script>