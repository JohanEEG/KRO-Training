@model List<KROTraining.Models.Asistencium>

@{
    ViewData["Title"] = "Historial de Asistencia";
}

<div class="kro-page-title">
    Historial de asistencia
</div>

<p class="kro-page-subtitle">
    Consulte los registros de asistencia de los clientes del gimnasio.
</p>

<div class="kro-actions" style="margin-bottom:20px; flex-wrap:wrap;">
    <a href="/ControlAsistencia/HistorialAsistencia" class="kro-btn kro-btn-outline">Historial de asistencia</a>
    <a href="/Cuenta/Perfil" class="kro-btn kro-btn-outline">Mi perfil</a>
    <form asp-controller="Cuenta" asp-action="Logout" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <button type="submit" class="kro-btn kro-btn-secondary">Cerrar sesión</button>
    </form>
</div>

<div class="kro-card">

    <div class="kro-card-title">
        Filtrar por rango de fechas
    </div>

    <form method="get" class="kro-form-grid">

        <div class="kro-form-group">
            <label class="kro-form-label">Fecha inicial</label>
            <input type="date" name="fechaInicio" class="kro-form-control"
                   value="@(ViewBag.FechaInicio != null ? ((DateOnly)ViewBag.FechaInicio).ToString("yyyy-MM-dd") : "")" />
        </div>

        <div class="kro-form-group">
            <label class="kro-form-label">Fecha final</label>
            <input type="date" name="fechaFin" class="kro-form-control"
                   value="@(ViewBag.FechaFin != null ? ((DateOnly)ViewBag.FechaFin).ToString("yyyy-MM-dd") : "")" />
        </div>

        <div class="kro-form-group" style="align-self:flex-end;">
            <button type="submit" class="kro-btn kro-btn-primary">Consultar asistencia</button>
        </div>

    </form>

</div>

<div class="kro-card">

    <div class="kro-card-title">
        Registros de asistencia
    </div>

    @if (ViewBag.SinResultados)
    {
        <p>No hay registros de asistencia para el rango seleccionado.</p>
    }
    else
    {
        <div class="kro-table-container">
            <table class="kro-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Hora de ingreso</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.Cliente.Usuario.Nombre</td>
                            <td>@a.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@a.Hora.ToString("hh\\:mm tt")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>