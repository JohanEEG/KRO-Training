```cshtml
@{
    ViewData["Title"] = "Historial de Asistencia";
}

<div class="kro-page-title">
    Historial de asistencia
</div>

<p class="kro-page-subtitle">
    Consulte los registros de asistencia de los clientes del gimnasio.
</p>


<div class="kro-card">

    <div class="kro-card-title">
        Consultar asistencia
    </div>


    <div class="kro-form-grid">

        <div class="kro-form-group">

            <label class="kro-form-label">
                Cliente
            </label>

            <select class="kro-form-control">

                <option>Seleccione un cliente</option>
                <option>Juan Pérez</option>
                <option>María Rodríguez</option>
                <option>Carlos Vargas</option>
                <option>Ana González</option>

            </select>

        </div>


        <div class="kro-form-group">

            <label class="kro-form-label">
                Fecha inicial
            </label>

            <input type="date"
                   class="kro-form-control" />

        </div>


        <div class="kro-form-group">

            <label class="kro-form-label">
                Fecha final
            </label>

            <input type="date"
                   class="kro-form-control" />

        </div>

    </div>


    <div class="kro-actions">

        <button type="button"
                class="kro-btn kro-btn-primary"
                onclick="alert('Consulta realizada correctamente.');">
            Consultar asistencia
        </button>

    </div>

</div>


<div class="kro-card">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">

        <div class="kro-card-title" style="margin:0;">
            Registros de asistencia
        </div>

        <a href="/ControlAsistencia/RegistrarIngreso"
           class="kro-btn kro-btn-outline">
            + Registrar ingreso
        </a>

    </div>


    <div class="kro-table-container">

        <table class="kro-table">

            <thead>

                <tr>

