@{
    ViewData["Title"] = "Visualizar Asistencia";
}

<div class="kro-page-title">
    Asistencia de clientes
</div>

<p class="kro-page-subtitle">
    Visualice el resumen de asistencia por cliente.
</p>

<div class="kro-card">

    <div class="kro-card-title">
        Resumen por cliente
    </div>

    <div class="kro-table-container">

        <table class="kro-table">

            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Total de asistencias</th>
                    <th>Última asistencia</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>Juan Pérez</td>
                    <td>12</td>
                    <td>17/08/2026</td>
                    <td><span class="kro-badge kro-badge-green">Activo</span></td>
                </tr>
                <tr>
                    <td>María Rodríguez</td>
                    <td>9</td>
                    <td>16/08/2026</td>
                    <td><span class="kro-badge kro-badge-green">Activo</span></td>
                </tr>
                <tr>
                    <td>Carlos Vargas</td>
                    <td>15</td>
                    <td>15/08/2026</td>
                    <td><span class="kro-badge kro-badge-green">Activo</span></td>
                </tr>
                <tr>
                    <td>Ana González</td>
                    <td>3</td>
                    <td>14/08/2026</td>
                    <td><span class="kro-badge kro-badge-green">Activo</span></td>
                </tr>
            </tbody>

        </table>

    </div>

</div>

<div class="kro-card">

    <div class="kro-card-title">
        Estadísticas generales
    </div>

    <div class="kro-stat-grid">

        <div class="kro-stat-card">
            <h3>TOTAL CLIENTES CON ASISTENCIA</h3>
            <strong>4</strong>
        </div>

        <div class="kro-stat-card">
            <h3>PROMEDIO DE ASISTENCIAS</h3>
            <strong>9.75</strong>
        </div>

        <div class="kro-stat-card">
            <h3>CLIENTE MÁS FRECUENTE</h3>
            <strong style="font-size:22px;">Carlos Vargas</strong>
        </div>

    </div>

</div>