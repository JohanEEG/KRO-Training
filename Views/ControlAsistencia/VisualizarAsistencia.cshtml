@model List<KROTraining.Models.Cliente>

@{
    ViewData["Title"] = "Visualizar Asistencia";
}

<div class="kro-page-title">
    Asistencia de mis clientes
</div>

<p class="kro-page-subtitle">
    Consulte la constancia de entrenamiento de sus clientes asignados.
</p>

<div class="kro-actions" style="margin-bottom:20px; flex-wrap:wrap;">
    <a href="/ControlAsistencia/VisualizarAsistencia" class="kro-btn kro-btn-outline">Mis clientes</a>
    <a href="/Cuenta/Perfil" class="kro-btn kro-btn-outline">Mi perfil</a>
    <form asp-controller="Cuenta" asp-action="Logout" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <button type="submit" class="kro-btn kro-btn-secondary">Cerrar sesión</button>
    </form>
</div>

<div class="kro-card">

    <div class="kro-card-title">
        Resumen por cliente
    </div>

    @if (!Model.Any())
    {
        <p>Aún no tiene clientes asignados.</p>
    }
    else
    {
        <div class="kro-table-container">
            <table class="kro-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Total de asistencias</th>
                        <th>Última asistencia</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Usuario.Nombre</td>
                            <td>@c.Asistencia.Count</td>
                            <td>
                                @if (c.Asistencia.Any())
                                {
                                    @c.Asistencia.Max(a => a.Fecha).ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span>Sin registros de asistencia</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>