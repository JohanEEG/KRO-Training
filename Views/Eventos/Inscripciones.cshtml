@model KROTraining.Models.InscripcionesViewModel

@{
    ViewData["Title"] = "Inscripciones";
}

<h1 class="kro-page-title">Inscripciones a eventos</h1>
<p class="kro-page-subtitle">Consulte y gestione los clientes inscritos en los eventos deportivos.</p>

@if (TempData["MensajeExito"] is string mensajeExito)
{
    <div role="status" class="kro-profile-alert kro-profile-success">✓ @mensajeExito</div>
}
@if (TempData["MensajeError"] is string mensajeError)
{
    <div role="alert" class="kro-profile-alert kro-profile-error">! @mensajeError</div>
}

<div class="kro-card">
    <div class="kro-card-title">Evento seleccionado</div>
    @if (!Model.Eventos.Any())
    {
        <p role="status">No existen eventos registrados.</p>
    }
    else
    {
        <form asp-controller="Eventos" asp-action="Inscripciones" method="get" class="kro-form-grid">
            <div class="kro-form-group">
                <label for="eventoId" class="kro-form-label">Evento</label>
                <select id="eventoId" name="id" class="kro-form-control" onchange="this.form.submit()">
                    @foreach (var evento in Model.Eventos)
                    {
                        if (evento.EventoId == Model.EventoId)
                        {
                            <option value="@evento.EventoId" selected>@evento.Nombre - @evento.Fecha.ToString("dd/MM/yyyy HH:mm")</option>
                        }
                        else
                        {
                            <option value="@evento.EventoId">@evento.Nombre - @evento.Fecha.ToString("dd/MM/yyyy HH:mm")</option>
                        }
                    }
                </select>
            </div>
        </form>
    }
</div>

@if (Model.EventoId.HasValue)
{
    <div class="kro-card">
        <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:20px;">
            <div class="kro-card-title" style="margin:0;">@Model.EventoNombre</div>
            @if (Model.ClientesDisponibles.Any() && Model.CuposDisponibles > 0)
            {
                <form asp-controller="Eventos" asp-action="InscribirCliente" method="post" style="display:flex; gap:8px; align-items:center;">
                    <input type="hidden" name="eventoId" value="@Model.EventoId" />
                    <select name="clienteId" class="kro-form-control" required>
                        <option value="">Seleccione un cliente</option>
                        @foreach (var cliente in Model.ClientesDisponibles)
                        {
                            <option value="@cliente.ClienteId">@cliente.Nombre (@cliente.Correo)</option>
                        }
                    </select>
                    <button type="submit" class="kro-btn kro-btn-primary">Registrar inscripción</button>
                    @Html.AntiForgeryToken()
                </form>
            }
            else if (Model.CuposDisponibles == 0)
            {
                <span class="kro-badge kro-badge-gray">No hay cupos disponibles</span>
            }
        </div>

        <div class="kro-stat-grid">
            <div class="kro-stat-card"><h3>CUPOS DISPONIBLES</h3><strong>@Model.CuposDisponibles</strong></div>
            <div class="kro-stat-card"><h3>INSCRITOS</h3><strong>@Model.Inscritos</strong></div>
            <div class="kro-stat-card"><h3>CAPACIDAD</h3><strong>@Model.CupoMaximo</strong></div>
        </div>
    </div>

    <div class="kro-card">
        <div class="kro-card-title">Clientes inscritos en @Model.EventoNombre</div>
        @if (!Model.Inscripciones.Any())
        {
            <p role="status">No hay clientes inscritos en este evento.</p>
        }
        else
        {
            <div class="kro-table-container">
                <table class="kro-table">
                    <thead><tr><th>Cliente</th><th>Correo</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var inscripcion in Model.Inscripciones)
                        {
                            <tr>
                                <td>@inscripcion.ClienteNombre</td>
                                <td>@inscripcion.ClienteCorreo</td>
                                <td>@inscripcion.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@inscripcion.Estado</td>
                                <td>
                                    @if (inscripcion.Estado != "CANCELADO")
                                    {
                                        <form asp-controller="Eventos" asp-action="CancelarInscripcion" method="post">
                                            <input type="hidden" name="eventoId" value="@inscripcion.EventoId" />
                                            <input type="hidden" name="clienteId" value="@inscripcion.ClienteId" />
                                            <button type="submit" class="kro-btn kro-btn-small kro-btn-alert-outline">Cancelar</button>
                                            @Html.AntiForgeryToken()
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
