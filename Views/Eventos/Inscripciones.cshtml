                    </td>

                    <td>
                        16/08/2026
                    </td>

                    <td>

                        <span class="kro-badge kro-badge-green">
                            Inscrito
                        </span>

                    </td>

                    <td>

                        <button type="button"
                                class="kro-btn kro-btn-small kro-btn-danger"
                                onclick="alert('Inscripción cancelada.');">
                            Cancelar
                        </button>

                    </td>

                </tr>


                <tr>

                    <td>
                        Carlos Vargas
                    </td>

                    <td>
                        carlos@email.com
                    </td>

                    <td>
                        16/08/2026
                    </td>

                    <td>

                        <span class="kro-badge kro-badge-gray">
                            Cancelado
                        </span>

                    </td>

                    <td>

                        <button type="button"
                                class="kro-btn kro-btn-small kro-btn-outline">
                            Ver detalle
                        </button>

                    </td>

                </tr>

            </tbody>

        </table>

    </div>

</div>


<div class="kro-card">

    <div class="kro-card-title">
        Resumen del evento
    </div>

    <div class="kro-stat-grid">

        <div class="kro-stat-card">

            <h3>
                CUPOS DISPONIBLES
