    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">

        <div class="kro-card-title" style="margin:0;">
            Eventos registrados
        </div>

        <button type="button"
                class="kro-btn kro-btn-primary"
                onclick="alert('Formulario para crear evento.');">
            + Nuevo evento
        </button>

    </div>


    <div class="kro-search">

        <input type="text"
               class="kro-form-control"
               placeholder="Buscar evento..." />

    </div>


