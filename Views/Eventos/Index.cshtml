@model List<KROTraining.Models.EventoListaViewModel>

@{
    ViewData["Title"] = "Eventos deportivos";
    bool puedeGestionar = ViewBag.PuedeGestionar is bool b && b;
    bool puedeGestionarInscripciones = ViewBag.PuedeGestionarInscripciones is bool inscripciones && inscripciones;
    var errorCarga = ViewBag.ErrorCarga as string;
}

@if (TempData["MensajeError"] is string mensajeError)
{
    <div role="alert" class="kro-profile-alert kro-profile-error">
        <span class="kro-alert-icon" aria-hidden="true">!</span>
        <span>@mensajeError</span>
    </div>
}

<h1 class="kro-page-title">Eventos deportivos</h1>

<p class="kro-page-subtitle">
    @(puedeGestionar
        ? "Cree y administre los eventos deportivos de KRÒ Training."
        : puedeGestionarInscripciones
            ? "Consulte los eventos y gestione sus inscripciones."
            : "Consulte los eventos deportivos programados en KRÒ Training.")
</p>

@if (TempData["MensajeExito"] is string mensajeExito)
{
    <div role="status" class="kro-profile-alert kro-profile-success">
        <span class="kro-alert-icon" aria-hidden="true">✓</span>
        <span>@mensajeExito</span>
    </div>
}

<div class="kro-card">

    <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:20px;">
        <div class="kro-card-title" style="margin:0;">Eventos registrados</div>

        @if (puedeGestionar)
        {
            <a asp-controller="Eventos" asp-action="Crear" class="kro-btn kro-btn-primary">+ Nuevo evento</a>
        }
    </div>

    @if (errorCarga != null)
    {
        <div role="alert" class="kro-profile-alert kro-profile-error">
            <span class="kro-alert-icon" aria-hidden="true">!</span>
            <span>@errorCarga</span>
        </div>
    }
    else if (!Model.Any())
    {
        <p role="status">No hay eventos registrados.</p>
    }
    else
    {
        <div class="kro-table-container">
            <table class="kro-table">
                <thead>
                    <tr>
                        <th scope="col">Evento</th>
                        <th scope="col">Fecha</th>
                        <th scope="col">Cupos</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>
                                <strong>@e.Nombre</strong>
                                @if (e.EstaInscrito)
                                {
                                    <br /><span class="kro-badge kro-badge-green">Inscrito</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(e.Descripcion))
                                {
                                    <br /><small>@e.Descripcion</small>
                                }
                            </td>
                            <td>@e.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@e.Inscritos / @e.CupoMaximo</td>
                            <td>
                                @if (e.EtiquetaEstado == "Próximo")
                                {
                                    <span class="kro-badge kro-badge-green">@e.EtiquetaEstado</span>
                                }
                                else
                                {
                                    <span class="kro-badge kro-badge-gray">@e.EtiquetaEstado</span>
                                }
                            </td>
                            @if (puedeGestionar)
                            {
                                <td>
                                    <a asp-controller="Eventos" asp-action="Detalle" asp-route-id="@e.EventoId"
                                       class="kro-btn kro-btn-small kro-btn-outline">Ver</a>
                                    <a asp-controller="Eventos" asp-action="Editar" asp-route-id="@e.EventoId"
                                       class="kro-btn kro-btn-small kro-btn-outline"
                                       aria-label="@($"Editar {e.Nombre}")">Editar</a>
                                    @if (puedeGestionarInscripciones)
                                    {
                                        <a asp-controller="Eventos" asp-action="Inscripciones" asp-route-id="@e.EventoId"
                                           class="kro-btn kro-btn-small kro-btn-outline">Inscripciones</a>
                                    }
                                </td>
                            }
                            else if (puedeGestionarInscripciones)
                            {
                                <td>
                                    <a asp-controller="Eventos" asp-action="Detalle" asp-route-id="@e.EventoId"
                                       class="kro-btn kro-btn-small kro-btn-outline">Ver detalle</a>
                                    <a asp-controller="Eventos" asp-action="Inscripciones" asp-route-id="@e.EventoId"
                                       class="kro-btn kro-btn-small kro-btn-outline">Inscripciones</a>
                                </td>
                            }
                            else
                            {
                                <td>
                                    <a asp-controller="Eventos" asp-action="Detalle" asp-route-id="@e.EventoId"
                                       class="kro-btn kro-btn-small kro-btn-outline">Ver detalle</a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
