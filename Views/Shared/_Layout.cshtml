@using System.Security.Claims
@{
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value?.ToUpper() ?? "";

    // Identificación de Roles
    bool esAdmin = userRole == "ADMINISTRADOR" || userRole == "ADMIN" || User.IsInRole("Administrador") || User.IsInRole("ADMINISTRADOR");
    bool esEntrenador = userRole == "ENTRENADOR" || User.IsInRole("Entrenador") || User.IsInRole("ENTRENADOR");
    bool esCliente = userRole == "CLIENTE" || User.IsInRole("Cliente") || User.IsInRole("CLIENTE");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - KRÒ Training</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Roboto:wght@400;500&display=swap"
          rel="stylesheet">

    <!-- CSS de KRÒ Training -->
    <link rel="stylesheet" href="~/css/kro-training.css" />

    <!-- ESTILOS DEL MODAL DE CIERRE DE SESIÓN (Aportados por tu compañero) -->
    <style>
            .kro-modal-overlay[hidden] {
                display: none;
            }

            .kro-modal-overlay {
                position: fixed;
                inset: 0;
                z-index: 1000;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
                background-color: rgba(28, 28, 28, 0.55);
            }

            .kro-modal {
                width: 100%;
                max-width: 420px;
                margin-bottom: 0;
                border-top: 4px solid var(--kro-red, #dc2626);
                text-align: center;
                background: #fff; /* Asegura fondo blanco por si acaso */
                padding: 25px;
                border-radius: 8px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            }

            .kro-modal-icon {
                font-size: 36px;
                margin-bottom: 10px;
            }

            .kro-modal .kro-card-title {
                margin-bottom: 10px;
                font-size: 20px;
                font-weight: 700;
            }

            .kro-modal p {
                margin: 0 0 22px;
                color: var(--kro-gray, #6b7280);
            }

            .kro-modal-actions {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 10px;
            }
    </style>
</head>
<body>

    <div class="kro-layout">

        <!-- =====================================================
             MENÚ LATERAL
             ===================================================== -->

        <aside class="kro-sidebar">

            <!-- LOGO -->
            <div class="kro-logo">
                <h1>KR<span>Ò</span></h1>
                <small>TRAINING</small>
            </div>

            <!-- PRINCIPAL (Oculto para Clientes) -->
            @if (!esCliente)
            {
                <div class="kro-menu-title">
                    Principal
                </div>

                <ul class="kro-menu">
                    <li>
                        <a href="/Home/Index">
                            🏠
                            <span>Dashboard</span>
                        </a>
                    </li>
                </ul>
            }

            <!-- =====================================================
                 SECCIÓN PARA CLIENTES
                 ===================================================== -->
            @if (esCliente)
            {
                <div class="kro-menu-title">
                    Mi Entrenamiento
                </div>

                <ul class="kro-menu">
                    <li>
                        <a asp-controller="ClienteRutinas" asp-action="Index">
                            💪
                            <span>Mi rutina asignada</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="ClienteRutinas" asp-action="Historial">
                            📋
                            <span>Historial de rutinas</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="MiMembresia" asp-action="Index">
                            💳
                            <span>Estado de la membresía</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Eventos/Index">
                            🏆
                            <span>Eventos deportivos</span>
                        </a>
                    </li>
                </ul>
            }

            <!-- =====================================================
                 SECCIÓN DE GESTIÓN (ADMINISTRADOR / ENTRENADOR)
                 ===================================================== -->
            @if (esAdmin || esEntrenador)
            {
                <div class="kro-menu-title">
                    Gestión
                </div>

                <ul class="kro-menu">

                    <!-- Clientes (Admin y Entrenador) -->
                    <li>
                        <a href="/Clientes/Index">
                            👥
                            <span>Clientes</span>
                        </a>
                    </li>

                    <!-- Usuarios (EXCLUSIVO ADMIN) -->
                    @if (esAdmin)
                    {
                        <li>
                            <a href="/Usuarios/Index">
                                👤
                                <span>Usuarios</span>
                            </a>
                        </li>
                    }

                    <!-- Rutinas (EXCLUSIVO ENTRENADOR) -->
                    @if (esEntrenador)
                    {
                        <li>
                            <a asp-controller="Rutinas" asp-action="Index">
                                💪
                                <span>Rutinas</span>
                            </a>
                        </li>
                    }

                    <!-- Roles y permisos (EXCLUSIVO ADMIN) -->
                    @if (esAdmin)
                    {
                        <li>
                            <a href="/Usuarios/Roles">
                                🔐
                                <span>Roles y permisos</span>
                            </a>
                        </li>
                    }

                    <!-- Multimedia (EXCLUSIVO ENTRENADOR) -->
                    @if (esEntrenador)
                    {
                        <li>
                            <a href="/Multimedia/CrearEjercicio">
                                🎥
                                <span>Multimedia</span>
                            </a>
                        </li>
                    }

                    <!-- Seguimiento físico (EXCLUSIVO ENTRENADOR) -->
                    @if (esEntrenador)
                    {
                        <li>
                            <a href="/SeguimientoFisico/ProgresoFisico">
                                📈
                                <span>Seguimiento físico</span>
                            </a>
                        </li>
                    }

                    <!-- Asistencia (Admin y Entrenador) -->
                    <li>
                        <a href="/ControlAsistencia/HistorialAsistencia">
                            📝
                            <span>Asistencia</span>
                        </a>
                    </li>

                    <!-- Eventos deportivos (Admin y Entrenador) -->
                    <li>
                        <a href="/Eventos/Index">
                            🏆
                            <span>Eventos deportivos</span>
                        </a>
                    </li>

                    <!-- Membresías y pagos (EXCLUSIVO ADMIN) -->
                    @if (esAdmin)
                    {
                        <li>
                            <a href="/Membresias/ProximasVencer">
                                💳
                                <span>Membresías y pagos</span>
                            </a>
                        </li>
                    }

                    <!-- Reportes (EXCLUSIVO ADMIN) -->
                    @if (esAdmin)
                    {
                        <li>
                            <a href="/Reportes/Estadisticas">
                                📊
                                <span>Reportes</span>
                            </a>
                        </li>
                    }

                    <!-- IA e innovación (EXCLUSIVO ENTRENADOR) -->
                    @if (esEntrenador)
                    {
                        <li>
                            <a href="/IA/DashboardMetas">
                                🤖
                                <span>IA e innovación</span>
                            </a>
                        </li>
                    }

                    <!-- Gestión de personal (EXCLUSIVO ADMIN) -->
                    @if (esAdmin)
                    {
                        <li>
                            <a href="/GestionPersonal/Index">
                                👔
                                <span>Gestión de personal</span>
                            </a>
                        </li>
                    }
                </ul>
            }

            <!-- =====================================================
                 CUENTA
                 ===================================================== -->

            <div class="kro-menu-title">
                Cuenta
            </div>

            <ul class="kro-menu">
                <li>
                    <a href="/Cuenta/Perfil">
                        ⚙️
                        <span>Mi Perfil</span>
                    </a>
                </li>

                <li>
                    <form asp-controller="Cuenta"
                          asp-action="Logout"
                          method="post"
                          id="logoutForm"
                          style="display: inline;">

                        <button type="submit"
                                style="background: none; border: none; color: inherit; width: 100%; text-align: left; padding: 10px 15px; display: flex; align-items: center; gap: 10px; cursor: pointer; font-family: inherit; font-size: inherit;">
                            🚪
                            <span>Cerrar sesión</span>
                        </button>
                    </form>
                </li>
            </ul>

        </aside>

        <!-- =====================================================
             CONTENIDO PRINCIPAL
             ===================================================== -->

        <main class="kro-main">

            <!-- BARRA SUPERIOR DINÁMICA -->
            <header class="kro-topbar">

                <div class="kro-topbar-title">
                    KRÒ Training
                </div>

                <div class="kro-user">
                    <div>
                        <strong>@(User.Identity!.IsAuthenticated ? User.Identity.Name : "Invitado")</strong>
                        <br />
                        <small>@(User.FindFirst(ClaimTypes.Role)?.Value ?? "Usuario")</small>
                    </div>

                    <div class="kro-user-icon">
                        👤
                    </div>
                </div>

            </header>

            <!-- CONTENIDO DE LA VISTA -->
            <section class="kro-content">
                @RenderBody()
            </section>

        </main>

    </div>

    <!-- =====================================================
         MODAL DE CONFIRMACIÓN DE CIERRE DE SESIÓN
         ===================================================== -->
    <div id="logoutModal" class="kro-modal-overlay" hidden>
        <div class="kro-modal">
            <div class="kro-modal-icon">🚪</div>
            <div class="kro-card-title">Cerrar sesión</div>
            <p>¿Estás seguro de que deseas cerrar sesión?</p>
            <div class="kro-modal-actions">
                <button type="button" id="btnCancelarLogout" class="kro-btn kro-btn-outline" style="padding: 8px 16px; cursor:pointer;">Cancelar</button>
                <button type="button" id="btnConfirmarLogout" class="kro-btn kro-btn-secondary" style="padding: 8px 16px; cursor:pointer; background: #dc2626; color: white; border: none; border-radius: 4px;">Sí, cerrar sesión</button>
            </div>
        </div>
    </div>

    <!-- SCRIPT PARA CONTROLAR EL MODAL DE CIERRE DE SESIÓN -->
    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const logoutForm = document.getElementById('logoutForm');
                const logoutModal = document.getElementById('logoutModal');
                const btnCancelarLogout = document.getElementById('btnCancelarLogout');
                const btnConfirmarLogout = document.getElementById('btnConfirmarLogout');

                let formTarget = null;

                if (logoutForm) {
                    logoutForm.addEventListener('submit', function (event) {
                        event.preventDefault(); // Detiene el envío inmediato del form
                        formTarget = this;
                        logoutModal.removeAttribute('hidden'); // Muestra el modal quitando el atributo hidden
                    });
                }

                if (btnCancelarLogout) {
                    btnCancelarLogout.addEventListener('click', function () {
                        logoutModal.setAttribute('hidden', 'true'); // Oculta el modal
                        formTarget = null;
                    });
                }

                if (btnConfirmarLogout) {
                    btnConfirmarLogout.addEventListener('click', function () {
                        if (formTarget) {
                            formTarget.submit(); // Envía el formulario formalmente
                        }
                    });
                }
            });
    </script>

    <!-- SCRIPTS -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>