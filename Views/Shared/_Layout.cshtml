<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - KRÒ Training</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Roboto:wght@400;500&display=swap"
          rel="stylesheet">

    <!-- CSS de KRÒ Training -->
    <link rel="stylesheet" href="~/css/kro-training.css" />
</head>

<body>

    <div class="kro-layout">

        <!-- =====================================================
             MENÚ LATERAL
             ===================================================== -->

        <aside class="kro-sidebar">

            <div class="kro-logo">
                <h1>KR<span>Ò</span></h1>
                <small>TRAINING</small>
            </div>

            <div class="kro-menu-title">
                Principal
            </div>

            <ul class="kro-menu">

                <li>
                    <a href="/Home/Index">
                        🏠
                        <span>Dashboard</span>
                    </a>
                </li>

            </ul>

            <div class="kro-menu-title">
                Gestión
            </div>

            <ul class="kro-menu">

                <li>
                    <a href="/Clientes/Index">
                        👥
                        <span>Clientes</span>
                    </a>
                </li>

                <li>
                    <a href="/Usuarios/Index">
                        👤
                        <span>Usuarios</span>
                    </a>
                </li>

                <li>
                    <a href="/Usuarios/Roles">
                        🔐
                        <span>Roles y permisos</span>
                    </a>
                </li>

            </ul>

            <div class="kro-menu-title">
                Cuenta
            </div>

            <ul class="kro-menu">

                <li>
                    <a href="/Cuenta/Login">
                        🚪
                        <span>Cerrar sesión</span>
                    </a>
                </li>

            </ul>

        </aside>


        <!-- =====================================================
             CONTENIDO PRINCIPAL
             ===================================================== -->

        <main class="kro-main">

            <!-- Barra superior -->

            <header class="kro-topbar">

                <div class="kro-topbar-title">
                    KRÒ Training
                </div>

                <div class="kro-user">

                    <div>
                        <strong>Administrador</strong>
                        <br />
                        <small>Administrador</small>
                    </div>

                    <div class="kro-user-icon">
                        👤
                    </div>

                </div>

            </header>


            <!-- Contenido de cada vista -->

            <section class="kro-content">

                @RenderBody()

            </section>

        </main>

    </div>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>